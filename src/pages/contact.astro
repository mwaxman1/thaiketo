---
import BaseLayout from "@layouts/BaseLayout.astro";
---

<BaseLayout
  title="Contact ThaiKeto"
  description="Get in touch with the ThaiKeto team. Questions, suggestions, or partnership inquiries."
>
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="text-4xl font-display font-semibold text-primary mb-8">Contact Us</h1>

    <div class="prose-thai">
      <p class="text-lg text-neutral-700 leading-relaxed mb-6">
        Have a question about Thai keto cooking? Want to suggest a recipe or product for review? We'd love to hear from you.
      </p>

      <h2>Get in Touch</h2>
      <p>
        For general inquiries, recipe suggestions, or partnership opportunities, email us at:
      </p>
      <p>
        <strong>hello@thaiketo.com</strong>
      </p>

      <h2>Newsletter</h2>
      <p>
        The best way to stay updated is to subscribe to our newsletter. We send weekly Thai keto recipes, meal plans, and product recommendations.
      </p>

      <form class="kc-email-capture flex flex-col sm:flex-row gap-3 max-w-md not-prose mt-4" action="/api/subscribe" method="POST">
        <input type="email" name="email" placeholder="Your email address" required class="form-input flex-1" />
        <input type="hidden" name="referrer" value="contact" />
        <button type="submit" class="btn btn-primary btn-lg whitespace-nowrap">Subscribe</button>
      </form>
      <p class="kc-email-note text-sm text-neutral-500 mt-2"></p>
    </div>
  </div>
</BaseLayout>
